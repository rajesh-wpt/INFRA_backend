# The app reads EXPO_PUBLIC_BACKEND_URL (see api/onboardingApi.ts, api/relayClient.ts,
# hooks/useForceLogout.ts). EXPO_PUBLIC_API_BASE_URL is NOT read by any of them.
#
# On a physical device this must be an address the PHONE can reach, never
# localhost — on the phone, localhost is the phone itself, so every request fails
# with "Failed to send OTP". Use this machine's LAN address, e.g.
# http://192.168.1.20:4000
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000