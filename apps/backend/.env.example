PORT=4000
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000

# Contact hash global salt (required for DB-2.3 privacy-preserving contact matching)
# Generate with: openssl rand -hex 32
# Supports both GLOBAL_SALT (per spec) and CONTACT_HASH_SALT (implementation name)
GLOBAL_SALT=
# CONTACT_HASH_SALT=  # Alternative name, GLOBAL_SALT takes precedence

# Self-hosted SMS gateway (LOGIN-3.5). No third-party provider (Twilio) is used.
# The gateway device authenticates with this bearer token when it polls
#   POST /api/v1/sms/outbox/poll
# and acknowledges with POST /api/v1/sms/outbox/:id/ack.
# Leave empty to disable the gateway endpoints (they answer 503).
SMS_GATEWAY_TOKEN=
# 32-byte key (64 hex chars or base64) encrypting the OTP in sms_outbox.payload.
# Generate with: openssl rand -hex 32
# Leave empty in local dev: codes are then printed as [SMS-DEV] to the console.
SMS_PAYLOAD_KEY=

# ── LOGIN-3.10 — Dashboard (admin) auth ──────────────────────
# Separate signing secret for admin tokens (aud: "dashboard"). Never reuse
# JWT_SECRET: key separation is what stops an app token from opening the
# dashboard and vice-versa.
# Generate with: openssl rand -base64 32
DASHBOARD_JWT_SECRET=
# Seed account for `tsx src/db/seed-dashboard-admins.ts` (password 12+ chars).
# DASHBOARD_SEED_EMAIL=admin@wpt.local
# DASHBOARD_SEED_PASSWORD=
# DASHBOARD_SEED_ROLE=owner
# DASHBOARD_SEED_TEST=false

# ── ENC-4.1 — prekey maintenance ─────────────────────────────
# How often the in-process job expires/refills prekey batches.
# Unset = every 6h. 0 = disabled (use an external cron instead).
# PREKEY_MAINTENANCE_INTERVAL_MS=21600000

# ── ENC-4.5 — encrypted media (group icons) ──────────────────
# Storage driver is picked per call: Supabase when the two vars below are set,
# otherwise the local filesystem driver (no account needed).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Local driver: where ciphertext blobs live (default ./var/media, gitignored).
# MEDIA_ROOT=var/media
# HMAC key for download URLs. Defaults to JWT_SECRET when unset.
# MEDIA_URL_SECRET=
# Absolute base URL used when minting media URLs (default http://localhost:PORT).
# PUBLIC_BASE_URL=http://localhost:4000

# ── Reverse proxy ────────────────────────────────────────────
# Trust X-Forwarded-For only when something in front of the process rewrites it
# (otherwise audit-log IPs can be spoofed). "true" trusts one hop, or set a CIDR
# count/string as Express accepts.
# TRUST_PROXY=
