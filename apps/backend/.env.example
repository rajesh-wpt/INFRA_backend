PORT=4000
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000

# Contact hash global salt (required for DB-2.3 privacy-preserving contact matching)
# Generate with: openssl rand -hex 32
# Supports both GLOBAL_SALT (per spec) and CONTACT_HASH_SALT (implementation name)
GLOBAL_SALT=
# CONTACT_HASH_SALT=  # Alternative name, GLOBAL_SALT takes precedence

# Self-hosted SMS gateway (LOGIN-3.5). No third-party provider (Twilio) is used.
# The gateway device authenticates with this bearer token when it polls
#   POST /api/v1/sms/outbox/poll
# and acknowledges with POST /api/v1/sms/outbox/:id/ack.
# Leave empty to disable the gateway endpoints (they answer 503).
SMS_GATEWAY_TOKEN=
# 32-byte key (64 hex chars or base64) encrypting the OTP in sms_outbox.payload.
# Generate with: openssl rand -hex 32
# Leave empty in local dev: codes are then printed as [SMS-DEV] to the console.
SMS_PAYLOAD_KEY=
